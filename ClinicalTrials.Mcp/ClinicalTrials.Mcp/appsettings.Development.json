{
  "StudyService": {
    "BaseUrl": "http://localhost:5010/"
  },
  "Authentication": {
    "ApiKeys": {
      "HeaderName": "X-Api-Key"
    }
  },
  "ConnectionStrings": {
    "ClientRegistry": "",
    "Redis": ""
  },
  "Caching": {
    "Provider": "Memory",
    "SuccessTtlSeconds": 300,
    "NotFoundTtlSeconds": 60
  },
  "RateLimiting": {
    "Provider": "Memory",
    "WindowSeconds": 60,
    "PerClientPermitLimit": 120,
    "GlobalPermitLimit": 1000
  },
  "Secrets": {
    "Provider": "Local"
  },
  "Telemetry": {
    "ApplicationInsights": {
      "ConnectionString": ""
    }
  },
  "Hosting": {
    "ForwardedHeaders": {
      "Enabled": false
    }
  },
  "LocalDevelopment": {
    "SeedApiKey": "clinical-trials-local-dev-key",
    "ClientRegistrySetup": "Server=localhost;Database=ClinicalTrialsMcp;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
