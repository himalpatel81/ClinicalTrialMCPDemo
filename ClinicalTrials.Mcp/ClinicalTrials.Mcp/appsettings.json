{
  "StudyService": {
    "BaseUrl": "",
    "StudyLookupPathTemplate": "api/studies/{nctId}",
    "Resilience": {
      "TotalRequestTimeoutSeconds": 15,
      "AttemptTimeoutSeconds": 5,
      "MaxRetryAttempts": 2,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerMinimumThroughput": 5,
      "CircuitBreakerSamplingWindowSeconds": 30,
      "CircuitBreakerBreakDurationSeconds": 30
    }
  },
  "Authentication": {
    "ApiKeys": {
      "HeaderName": "X-Api-Key"
    }
  },
  "Hosting": {
    "ForwardedHeaders": {
      "Enabled": false
    }
  },
  "ConnectionStrings": {
    "ClientRegistry": "",
    "Redis": ""
  },
  "Caching": {
    "Provider": "Redis",
    "SuccessTtlSeconds": 300,
    "NotFoundTtlSeconds": 60
  },
  "Secrets": {
    "Provider": "Local",
    "AzureKeyVault": {
      "VaultUri": ""
    }
  },
  "Telemetry": {
    "Console": {
      "Enabled": false
    },
    "ApplicationInsights": {
      "ConnectionString": ""
    }
  },
  "RateLimiting": {
    "Provider": "Redis",
    "WindowSeconds": 60,
    "PerClientPermitLimit": 60,
    "GlobalPermitLimit": 600
  },
  "RequestProtection": {
    "RequestTimeoutSeconds": 30,
    "MaxRequestBodySizeBytes": 1048576
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
