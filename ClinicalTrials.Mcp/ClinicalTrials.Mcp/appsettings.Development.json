{
  "StudyService": {
    "BaseUrl": "http://localhost:5010/",
    "Resilience": {
      "TotalRequestTimeoutSeconds": 15,
      "AttemptTimeoutSeconds": 5,
      "MaxRetryAttempts": 2,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerMinimumThroughput": 5,
      "CircuitBreakerSamplingWindowSeconds": 30,
      "CircuitBreakerBreakDurationSeconds": 30
    }
  },
  "Authentication": {
    "ApiKeys": {
      "HeaderName": "X-Api-Key"
    }
  },
  "ConnectionStrings": {
    "ClientRegistry": "",
    "Redis": ""
  },
  "Caching": {
    "Provider": "Memory",
    "SuccessTtlSeconds": 300,
    "NotFoundTtlSeconds": 60
  },
  "RateLimiting": {
    "Provider": "Memory",
    "WindowSeconds": 60,
    "PerClientPermitLimit": 120,
    "GlobalPermitLimit": 1000
  },
  "RequestProtection": {
    "RequestTimeoutSeconds": 30,
    "MaxRequestBodySizeBytes": 1048576
  },
  "Secrets": {
    "Provider": "Local",
    "AzureKeyVault": {
      "VaultUri": ""
    }
  },
  "Telemetry": {
    "Console": {
      "Enabled": false
    },
    "ApplicationInsights": {
      "ConnectionString": ""
    }
  },
  "Hosting": {
    "ForwardedHeaders": {
      "Enabled": false
    }
  },
  "LocalDevelopment": {
    "SeedApiKey": "clinical-trials-local-dev-key",
    "ClientRegistrySetup": "Server=localhost;Database=ClinicalTrialsMcp;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
